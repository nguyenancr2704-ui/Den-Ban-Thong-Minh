// =========================================================================
// HÀM TIỆN ÍCH LƯU / TẢI CẤU HÌNH & ĐIỀU KHIỂN PHẦN CỨNG
// =========================================================================
void applyOledSettings() {
  if (!oledReady) return;
  display.setRotation(cfgOledFlip ? 2 : 0);
}

void loadSettings() {
  preferences.begin("lamp-cfg", false);
  savedSSID      = preferences.getString("ssid", "");
  savedPass      = preferences.getString("pass", "");
  cfgTopMode     = preferences.getInt("topMode", 0);
  cfgShowClock   = preferences.getBool("showClock", true);
  cfgShowLux     = preferences.getBool("showLux", true);
  cfgShowDist    = preferences.getBool("showDist", true);
  cfgOledFlip    = preferences.getBool("oledFlip", false);
  cfgDistThresh  = preferences.getInt("distThresh", 60);
  cfgOffDelaySec = preferences.getInt("offDelay", 5);
  preferences.end();
}

String escapeJson(String s) {
  s.replace("\\", "\\\\");
  s.replace("\"", "\\\"");
  return s;
}

// =========================================================================
// CÁC ROUTE XỬ LÝ CỦA WEB SERVER
// =========================================================================
void handleRoot() {
  server.send_P(200, "text/html; charset=utf-8", INDEX_HTML);
}

void handleStatus() {
  bool connected = (WiFi.status() == WL_CONNECTED);
  String modeStr = (currentMode == MODE_AUTO) ? "AUTO" : (currentMode == MODE_MANUAL_ON ? "ON" : "OFF");

  String json = "{";
  json += "\"connected\":" + String(connected ? "true" : "false") + ",";
  json += "\"ssid\":\"" + escapeJson(savedSSID) + "\",";
  json += "\"ip\":\"" + (connected ? WiFi.localIP().toString() : "192.168.4.1") + "\",";
  json += "\"mode\":\"" + modeStr + "\",";
  json += "\"lux\":" + String((int)currentLux) + ",";
  json += "\"dist\":" + String(currentDistance) + ",";
  json += "\"present\":" + String(isHumanPresent ? "true" : "false") + ",";
  json += "\"pwm\":" + String(currentPwm) + ",";
  json += "\"hdr\":\"" + String(cfgTopMode == 0 ? "d" : "n") + "\",";
  json += "\"clk\":" + String(cfgShowClock ? "true" : "false") + ",";
  json += "\"mod\":" + String(cfgShowLux ? "true" : "false") + ",";
  json += "\"per\":" + String(cfgShowDist ? "true" : "false") + ",";
  json += "\"flip\":" + String(cfgOledFlip ? "true" : "false");
  json += "}";
  server.send(200, "application/json", json);
}

void handleSetMode() {
  if (server.hasArg("mode")) {
    String m = server.arg("mode");
    if (m == "AUTO") currentMode = MODE_AUTO;
    else if (m == "ON") currentMode = MODE_MANUAL_ON;
    else if (m == "OFF") currentMode = MODE_MANUAL_OFF;
  }
  server.send(200, "application/json", "{\"ok\":true}");
}

void handleSaveOled() {
  if (server.hasArg("hdr")) {
    cfgTopMode = (server.arg("hdr") == "n") ? 1 : 0;
  }
  if (server.hasArg("clk"))  cfgShowClock = (server.arg("clk") == "1");
  if (server.hasArg("mod"))  cfgShowLux   = (server.arg("mod") == "1");
  if (server.hasArg("per"))  cfgShowDist  = (server.arg("per") == "1");
  if (server.hasArg("flip")) cfgOledFlip  = (server.arg("flip") == "1");

  preferences.begin("lamp-cfg", false);
  preferences.putInt("topMode", cfgTopMode);
  preferences.putBool("showClock", cfgShowClock);
  preferences.putBool("showLux", cfgShowLux);
  preferences.putBool("showDist", cfgShowDist);
  preferences.putBool("oledFlip", cfgOledFlip);
  preferences.end();

  applyOledSettings();
  server.send(200, "application/json", "{\"ok\":true}");
}

void handleScan() {
  int n = WiFi.scanNetworks();
  String json = "[";
  for (int i = 0; i < n; i++) {
    if (i > 0) json += ",";
    json += "{\"ssid\":\"" + escapeJson(WiFi.SSID(i)) + "\",";
    json += "\"rssi\":" + String(WiFi.RSSI(i)) + ",";
    json += "\"enc\":" + String(WiFi.encryptionType(i) != WIFI_AUTH_OPEN ? "true" : "false") + "}";
  }
  json += "]";
  WiFi.scanDelete();
  server.send(200, "application/json", json);
}

void handleSaveWifi() {
  if (server.hasArg("ssid")) {
    String newSSID = server.arg("ssid");
    String newPass = server.hasArg("pass") ? server.arg("pass") : "";
    newSSID.trim();

    if (newSSID.length() > 0) {
      preferences.begin("lamp-cfg", false);
      preferences.putString("ssid", newSSID);
      preferences.putString("pass", newPass);
      preferences.end();

      savedSSID = newSSID;
      savedPass = newPass;
      manualPortal = false;

      server.send(200, "application/json", "{\"ok\":true}");
      delay(300);

      WiFi.begin(savedSSID.c_str(), savedPass.c_str());
      wifiConnectStart = millis();
      configTime(gmtOffset_sec, daylightOffset_sec, ntpServer1, ntpServer2);
      return;
    }
  }
  server.send(400, "application/json", "{\"ok\":false}");
}

void startConfigPortal(bool isManual = false) {
  if (!portalActive) {
    WiFi.mode(WIFI_AP_STA);
    WiFi.softAP(AP_SSID);
    delay(100);
    dnsServer.start(DNS_PORT, "*", WiFi.softAPIP());
    portalActive = true;
    manualPortal = isManual;
    Serial.println("Da bat Wi-Fi cau hinh: SmartLamp_Setup (192.168.4.1)");
  }
}

void stopConfigPortal() {
  if (portalActive) {
    dnsServer.stop();
    WiFi.softAPdisconnect(true);
    WiFi.mode(WIFI_STA);
    portalActive = false;
    manualPortal = false;
    Serial.println("Da tat Wi-Fi cau hinh.");
  }
}

// =========================================================================
// CẢM BIẾN SIÊU ÂM HC-SR04
// =========================================================================
int readUltrasonicDistance() {
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);
  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);

  long duration = pulseIn(ECHO_PIN, HIGH, 20000);
  if (duration == 0) return 999;
  return duration * 0.0343 / 2;
}

// =========================================================================
// SETUP
// =========================================================================
void setup() {
  Serial.begin(115200);

  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);
  pinMode(TOUCH_MODE_PIN, INPUT);
  pinMode(TOUCH_WIFI_PIN, INPUT);

  #if defined(ESP_ARDUINO_VERSION_MAJOR) && ESP_ARDUINO_VERSION_MAJOR >= 3
    ledcAttach(LED_PIN, PWM_FREQ, PWM_RES);
  #else
    ledcSetup(PWM_CHANNEL, PWM_FREQ, PWM_RES);
    ledcAttachPin(LED_PIN, PWM_CHANNEL);
  #endif

  loadSettings();
  Wire.begin(21, 22);

  if (display.begin(SSD1306_SWITCHCAPVCC, OLED_ADDRESS)) {
    oledReady = true;
    applyOledSettings();
    display.clearDisplay();
    display.setTextColor(SSD1306_WHITE);
    display.setTextSize(1);
    display.setCursor(14, 20);
    display.println("Smart Desk Lamp");
    display.setCursor(14, 38);
    display.println("Dang khoi dong...");
    display.display();
  }

  bh1750Ready = lightMeter.begin(BH1750::CONTINUOUS_HIGH_RES_MODE);

  // Khởi tạo Wi-Fi TRƯỚC khi gọi server.begin()
  if (savedSSID.length() > 0) {
    WiFi.mode(WIFI_STA);
    WiFi.begin(savedSSID.c_str(), savedPass.c_str());
    wifiConnectStart = millis();
    configTime(gmtOffset_sec, daylightOffset_sec, ntpServer1, ntpServer2);
  } else {
    startConfigPortal(false);
  }

  // Khai báo các API cho Web Server
  server.on("/", HTTP_GET, handleRoot);
  server.on("/status", HTTP_GET, handleStatus);
  server.on("/set-mode", HTTP_POST, handleSetMode);
  server.on("/save-oled", HTTP_POST, handleSaveOled);
  server.on("/scan", HTTP_GET, handleScan);
  server.on("/save-wifi", HTTP_POST, handleSaveWifi);
  server.onNotFound(handleRoot);
  server.begin();
}

// =========================================================================
// LOOP
// =========================================================================
void loop() {
  unsigned long currentMillis = millis();

  if (portalActive) {
    dnsServer.processNextRequest();
  }
  server.handleClient();

  // --- 1. XỬ LÝ 2 CẢM ỨNG TTP223 ---
  static bool lastModeTouch = LOW;
  static bool lastWifiTouch = LOW;
  static unsigned long lastTouchTime = 0;

  bool currModeTouch = digitalRead(TOUCH_MODE_PIN);
  bool currWifiTouch = digitalRead(TOUCH_WIFI_PIN);

  if (currModeTouch == HIGH && lastModeTouch == LOW && (currentMillis - lastTouchTime > 250)) {
    lastTouchTime = currentMillis;
    if (currentMode == MODE_AUTO) currentMode = MODE_MANUAL_ON;
    else if (currentMode == MODE_MANUAL_ON) currentMode = MODE_MANUAL_OFF;
    else currentMode = MODE_AUTO;
  }
  lastModeTouch = currModeTouch;

  if (currWifiTouch == HIGH && lastWifiTouch == LOW && (currentMillis - lastTouchTime > 250)) {
    lastTouchTime = currentMillis;
    if (!portalActive) startConfigPortal(true);
    else stopConfigPortal();
  }
  lastWifiTouch = currWifiTouch;

  // --- 2. QUẢN LÝ WI-FI, MDNS & NTP ---
  static bool mdnsStarted = false;
  if (WiFi.status() == WL_CONNECTED) {
    if (portalActive && !manualPortal) {
      stopConfigPortal();
    }
    if (!mdnsStarted) {
      if (MDNS.begin(MDNS_NAME)) {
        mdnsStarted = true;
        Serial.print("Web dieu khien san sang tai: http://denban.local hoac http://");
        Serial.println(WiFi.localIP());
      }
    }
  } else {
    mdnsStarted = false;
    if (savedSSID.length() > 0 && !portalActive && (currentMillis - wifiConnectStart > 15000)) {
      startConfigPortal(false);
    }
    if (savedSSID.length() > 0 && (currentMillis - lastWiFiCheck > 10000)) {
      lastWiFiCheck = currentMillis;
      WiFi.begin(savedSSID.c_str(), savedPass.c_str());
    }
  }

  struct tm timeinfo;
  bool timeValid = false;
  if (WiFi.status() == WL_CONNECTED || hasSyncedTimeOnce) {
    timeValid = getLocalTime(&timeinfo, 10);
    if (timeValid) hasSyncedTimeOnce = true;
  }

  // --- 3. CẢM BIẾN HIỆN DIỆN HC-SR04 ---
  currentDistance = readUltrasonicDistance();
  unsigned long offDelayMs = (unsigned long)cfgOffDelaySec * 1000UL;

  if (currentDistance > 0 && currentDistance <= cfgDistThresh) {
    isHumanPresent = true;
    lastPresenceTime = currentMillis;
  } else if (currentMillis - lastPresenceTime > offDelayMs) {
    isHumanPresent = false;
  }

  // --- 4. ĐIỀU CHỈNH ĐỘ SÁNG LED D23 ---
  float lux = bh1750Ready ? lightMeter.readLightLevel() : -1.0;
  bool luxValid = (lux >= 0);
  if (!luxValid) lux = 0;
  currentLux = lux;

  bool shouldLightBeOn = (currentMode == MODE_MANUAL_ON) || (currentMode == MODE_AUTO && isHumanPresent);
  int pwmValue = 0;
  if (shouldLightBeOn) {
    pwmValue = (lux >= 500.0) ? 10 : map((long)lux, 0, 500, 255, 10);
    pwmValue = constrain(pwmValue, 0, 255);
  }
  currentPwm = pwmValue;

  #if defined(ESP_ARDUINO_VERSION_MAJOR) && ESP_ARDUINO_VERSION_MAJOR >= 3
    ledcWrite(LED_PIN, pwmValue);
  #else
    ledcWrite(PWM_CHANNEL, pwmValue);
  #endif

  // --- 5. HIỂN THỊ OLED THEO CẤU HÌNH TRÊN WEB ---
  if (oledReady) {
    display.clearDisplay();

    if (portalActive) {
      display.setTextSize(1);
      display.setCursor(12, 0);
      display.print("== CAI DAT WIFI ==");
      display.setCursor(0, 12);
      display.print("WiFi: ");
      display.print(AP_SSID);
      display.setCursor(0, 22);
      display.print("Web : 192.168.4.1");
    } else {
      display.setTextSize(1);
      if (cfgTopMode == 0) {
        display.setCursor(30, 0);
        if (timeValid) {
          char dateStr[15];
          strftime(dateStr, sizeof(dateStr), "%d/%m/%Y", &timeinfo);
          display.print(dateStr);
        } else {
          display.print("Dang lay gio...");
        }
      } else {
        display.setCursor(10, 0);
        display.print("DEN BAN THONG MINH");
      }

      if (cfgShowClock) {
        display.setTextSize(2);
        display.setCursor(16, 12);
        if (timeValid) {
          char timeStr[10];
          strftime(timeStr, sizeof(timeStr), "%H:%M:%S", &timeinfo);
          display.print(timeStr);
        } else {
          display.print("--:--:--");
        }
      }
    }

    bool hasTop = true;
    bool hasBottom = cfgShowLux || cfgShowDist;
    if (hasTop && hasBottom) {
      display.drawFastHLine(0, 31, 128, SSD1306_WHITE);
    }

    display.setTextSize(1);
    if (cfgShowLux) {
      display.setCursor(0, 36);
      display.print("Mode: ");
      if (currentMode == MODE_AUTO) display.print("AUTO");
      else if (currentMode == MODE_MANUAL_ON) display.print("ON  ");
      else display.print("OFF ");

      display.setCursor(75, 36);
      display.print("Lux:");
      if (luxValid) display.print((int)lux);
      else display.print("ERR");
    }

    if (cfgShowDist) {
      int yDist = cfgShowLux ? 50 : 38;
      display.setCursor(0, yDist);
      display.print("Nguoi: ");
      if (isHumanPresent) {
        if (currentDistance <= cfgDistThresh) {
          display.print("CO (");
          display.print(currentDistance);
          display.print("cm)");
        } else {
          display.print("CHO TAT...");
        }
      } else {
        display.print("KHONG");
      }
    }

    display.display();
  }

  delay(50);
}
