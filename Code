<script>
const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];
let mode='AUTO',manualHold=0;
const lk='<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>';

function renderNets(list){
  $('#nets').innerHTML=list.map(([n,l,r])=>{
    const q=r>-55?4:r>-67?3:r>-75?2:1,c=r>-65?'g':r>-75?'a':'d';
    return`<li data-s="${n}"><span class="b ${c}">${[1,2,3,4].map(i=>`<i${i<=q?' class="on"':''}></i>`).join('')}</span><em>${n}</em>${l?lk:'<u>Mở</u>'}<s class="${c}">${r} dBm</s></li>`;
  }).join('');
  $$('#nets li').forEach(li=>li.onclick=()=>{$('#ssid').value=li.dataset.s;$$('#nets li').forEach(x=>x.classList.toggle('sel',x===li))});
}

function renderVisual(l,d,p,w){
  $('#pct').textContent=Math.round(w/2.55)+'%';
  $('#pwm').textContent='PWM: '+w+'/255';
  $('#lv').textContent=Math.round(l)+' lx';
  $('#dv').textContent=d+' cm';
  $('#om').textContent='Mode: '+mode;
  $('#ol').textContent='Lux:'+Math.round(l);
  $('#op').textContent='Nguoi: '+(p?'CO ('+d+'cm)':'KHONG');
  document.documentElement.style.setProperty('--p',w/255);
}

function upSim(){
  manualHold=Date.now()+4000;
  const l=+$('#lux').value,d=+$('#dst').value,p=d<=60;
  let w=0;
  if(mode=='ON'||(mode=='AUTO'&&p)) w=(l>=500)?10:Math.round(255-(l/500)*245);
  renderVisual(l,d,p,w);
}

function applyOledPreview(){
  $$('[data-t]').forEach(c=>{
    const t=c.dataset.t,v=c.checked?'visible':'hidden';
    if(t=='clk')$('#oc').style.visibility=v;
    if(t=='mod'){$('#om').style.visibility=v;$('#ol').style.visibility=v;}
    if(t=='per')$('#op').style.visibility=v;
    if(t=='flip')$('#oled').style.transform=c.checked?'rotate(180deg)':'';
  });
}

function saveOled(){
  applyOledPreview();
  const body=new URLSearchParams({
    hdr:$('#hdr').value,
    clk:$('[data-t="clk"]').checked?'1':'0',
    mod:$('[data-t="mod"]').checked?'1':'0',
    per:$('[data-t="per"]').checked?'1':'0',
    flip:$('[data-t="flip"]').checked?'1':'0'
  });
  fetch('/save-oled',{method:'POST',body}).catch(()=>{});
}

$$('[data-m]').forEach(b=>b.onclick=()=>{
  mode=b.dataset.m;
  $$('[data-m]').forEach(x=>x.classList.toggle('on',x===b));
  upSim();
  fetch('/set-mode',{method:'POST',body:new URLSearchParams({mode})}).catch(()=>{});
});

$('#lux').oninput=$('#dst').oninput=upSim;
$$('[data-t]').forEach(c=>c.onchange=saveOled);
$('#hdr').onchange=()=>{tick();saveOled();};

function tick(){
  const d=new Date(),z=n=>String(n).padStart(2,0);
  $('#oc').textContent=z(d.getHours())+':'+z(d.getMinutes())+':'+z(d.getSeconds());
  $('#oh').textContent=$('#hdr').value=='d'?z(d.getDate())+'/'+z(d.getMonth()+1)+'/'+d.getFullYear():'DEN BAN THONG MINH';
}

function scanWiFi(){
  const b=$('#scan');
  b.classList.add('spin');
  fetch('/scan')
    .then(r=>r.json())
    .then(arr=>{
      b.classList.remove('spin');
      if(arr.length) renderNets(arr.map(x=>[x.ssid,x.enc?1:0,x.rssi]));
      else $('#nets').innerHTML='<li><em>Không tìm thấy mạng Wi-Fi 2.4GHz</em></li>';
    })
    .catch(()=>b.classList.remove('spin'));
}
$('#scan').onclick=scanWiFi;

$('#save').onclick=()=>{
  const s=$('#ssid').value.trim(),p=$('#pass').value;
  if(!s){$('#ssid').focus();return;}
  const b=$('#save'),orig=b.textContent;
  b.textContent='Đang lưu & kết nối...';
  fetch('/save-wifi',{method:'POST',body:new URLSearchParams({ssid:s,pass:p})})
    .then(r=>r.json())
    .then(()=>{
      $('#wSaved').textContent=s;
      $('#wState').textContent='Đang kết nối tới '+s+'...';
      b.textContent='Đã lưu vào ESP32!';
      setTimeout(()=>b.textContent=orig,2500);
    })
    .catch(()=>{b.textContent=orig;});
};

let firstSync=true;
function syncESP(){
  fetch('/status')
    .then(r=>r.json())
    .then(st=>{
      $('#topBanner').textContent=st.connected
        ?('Đã kết nối ESP32 · Wi-Fi: '+st.ssid)
        :('Chế độ cấu hình trực tiếp AP ('+st.ip+')');
      $('#wState').textContent=st.connected?'Đã kết nối Internet':'Chưa kết nối (Đang phát AP)';
      $('#wSaved').textContent=st.ssid||'Chưa có';
      $('#wIp').textContent=st.connected?('http://denban.local (hoặc http://'+st.ip+')'):'http://192.168.4.1';

      if(firstSync){
        firstSync=false;
        if(st.ssid && !$('#ssid').value) $('#ssid').value=st.ssid;
        $('#hdr').value=st.hdr;
        $('[data-t="clk"]').checked=st.clk;
        $('[data-t="mod"]').checked=st.mod;
        $('[data-t="per"]').checked=st.per;
        $('[data-t="flip"]').checked=st.flip;
        applyOledPreview();
        tick();
      }

      if(Date.now()>manualHold){
        mode=st.mode;
        $$('[data-m]').forEach(x=>x.classList.toggle('on',x.dataset.m==mode));
        $('#lux').value=Math.min(520,Math.round(st.lux));
        $('#dst').value=Math.min(200,Math.max(5,st.dist));
        renderVisual(st.lux,st.dist,st.present,st.pwm);
      }
    })
    .catch(()=>{});
}

function th(v){document.body.dataset.th=v;$$('.th button').forEach(x=>x.classList.toggle('on',x.dataset.th==v));try{localStorage.setItem('th3',v)}catch(e){}}
$$('.th button').forEach(b=>b.onclick=()=>th(b.dataset.th));
let s0='a';try{s0=localStorage.getItem('th3')||'a'}catch(e){}th(['a','n','m'].includes(s0)?s0:'a');

setInterval(tick,1000);
setInterval(syncESP,1200);
tick();
syncESP();
scanWiFi();
</script></body></html>
